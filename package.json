{
  "name": "ludinator",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "server": "bun run src/server/server.ts",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:server": "bun test src/server/",
    "test:all": "vitest run --exclude='**/server/**' && bun test src/server/",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "start": "bun run src/server/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Festival management web app with TypeScript",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "jsdom": "^29.0.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
